# Creami Cravings Configuration
# Copy this file to .env to configure local environment variables

# Port for local web server (defaults to 8000)
PORT=8000

# Google OAuth 2.0 Client ID (from Google Cloud Console Credentials)
# Example: 123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# Comma-separated list of designated administrator emails
CREAMI_ADMIN_EMAILS=admin@creamicravings.com,ahumpo7@gmail.com

# Automated Offsite Database Backup Options (Optional)
# Supports AWS S3, Cloudflare R2, Backblaze B2, Google Cloud Storage, Wasabi
# OFFSITE_BACKUP_S3_BUCKET=my-creami-backups
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com  # If using Cloudflare R2 or Backblaze B2
# OFFSITE_S3_PREFIX=creami-cravings/backups

# Offsite Backup Status Notifications (Optional)
# Sends webhook alert on success/failure (Discord, Slack, or Healthchecks.io ping)
# OFFSITE_BACKUP_WEBHOOK_URL=https://discord.com/api/webhooks/...

